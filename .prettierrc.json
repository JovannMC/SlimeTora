{
	"printWidth": 120,
	"tabWidth": 4,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"arrowParens": "always",
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-organize-imports", "prettier-plugin-tailwindcss"],
	"tailwindStylesheet": "./src/renderer/src/app.css",
	"overrides": [{ "files": "*.svelte", "options": { "parser": "svelte" } }]
}
