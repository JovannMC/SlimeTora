{
	"name": "slimetora",
	"productName": "SlimeTora",
	"desktopName": "SlimeTora",
	"version": "2.0.0-beta.2",
	"homepage": "https://github.com/JovannMC/SlimeTora",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JovannMC/SlimeTora.git"
	},
	"bugs": {
		"url": "https://github.com/JovannMC/SlimeTora/issues",
		"email": "hello@jovann.me"
	},
	"description": "Connects the HaritoraX full body trackers to the SlimeVR server",
	"author": {
		"name": "JovannMC",
		"email": "hello@jovann.me"
	},
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
	"main": "dist/main/index.js",
	"license": "MIT",
	"workspaces": [
		"src/renderer"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "concurrently -k -n renderer,desktop -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:desktop\"",
		"dev:renderer": "pnpm --filter slimetora-renderer run dev",
		"dev:desktop": "node scripts/dev-desktop.mjs",
		"build": "pnpm run build:renderer && pnpm run build:node",
		"build:renderer": "pnpm --filter slimetora-renderer run build",
		"build:node": "node scripts/build-node.mjs",
		"start": "pnpm run build && electron .",
		"typecheck": "pnpm run typecheck:node && pnpm run typecheck:renderer",
		"typecheck:node": "tsc -p tsconfig.node.json --noEmit",
		"typecheck:renderer": "pnpm --filter slimetora-renderer run typecheck",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
		"package": "pnpm run build && electron-builder --dir",
		"dist": "pnpm run build && electron-builder --publish never"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify/svelte": "^5.2.4",
		"@types/node": "^24.19.2",
		"@types/three": "^0.187.0",
		"concurrently": "^10.0.7",
		"electron": "^45.2.3",
		"electron-builder": "^26.18.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"wait-on": "^9.5.1"
	},
	"allowScripts": {
		"electron@44.9.1": true,
		"esbuild@0.28.2": true
	},
	"dependencies": {
		"@fontsource/chakra-petch": "^5.3.0",
		"@serialport/bindings-cpp": "^13.0.1",
		"@serialport/stream": "^13.0.0",
		"@slimevr/common": "^0.1.3",
		"@slimevr/firmware-protocol": "^0.6.6",
		"@slimevr/tracker-emulation": "^0.2.6",
		"@stoprocent/noble": "^2.8.0",
		"clsx": "^2.1.1",
		"dbus-next": "^0.10.2",
		"haritorax-interpreter": "4.2.0",
		"overlayscrollbars": "^2.17.0",
		"quaternion": "^2.2.0",
		"rand-seed": "^3.0.0",
		"systeminformation": "^5.33.19",
		"three": "^0.187.0"
	}
}
